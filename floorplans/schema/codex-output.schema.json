{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "name", "unit", "walls", "openings", "spaces"],
  "properties": {
    "version": {"const": 1},
    "id": {"type": "string"},
    "name": {"type": "string"},
    "unit": {"const": "mm"},
    "walls": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id","a","b","thickness","kind","evidence"],
        "properties": {
          "id":{"type":"string"},
          "a":{"type":"array","prefixItems":[{"type":"number"},{"type":"number"}],"minItems":2,"maxItems":2},
          "b":{"type":"array","prefixItems":[{"type":"number"},{"type":"number"}],"minItems":2,"maxItems":2},
          "thickness":{"type":"number"},
          "kind":{"enum":["b","e","n","low"]},
          "evidence":{"$ref":"#/$defs/evidence"}
        }
      }
    },
    "openings": {
      "type":"array",
      "items":{
        "type":"object","additionalProperties":false,
        "required":["id","kind","wallId","at","width","evidence"],
        "properties":{
          "id":{"type":"string"},"kind":{"enum":["door","entry","window","slide","gap"]},
          "wallId":{"type":"string"},"at":{"type":"number"},"width":{"type":"number"},
          "evidence":{"$ref":"#/$defs/evidence"}
        }
      }
    },
    "spaces":{
      "type":"array",
      "items":{
        "type":"object","additionalProperties":false,
        "required":["id","sourceLabel","at","evidence"],
        "properties":{
          "id":{"type":"string"},"sourceLabel":{"type":"string"},
          "at":{"type":"array","prefixItems":[{"type":"number"},{"type":"number"}],"minItems":2,"maxItems":2},
          "evidence":{"$ref":"#/$defs/evidence"}
        }
      }
    }
  },
  "$defs":{
    "evidence":{
      "type":"object","additionalProperties":false,
      "required":["kind","confidence","note"],
      "properties":{
        "kind":{"enum":["dimension","scale","inferred","manual"]},
        "confidence":{"type":"number","minimum":0,"maximum":1},
        "note":{"type":"string"}
      }
    }
  }
}
